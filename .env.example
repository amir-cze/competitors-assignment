# ---- required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- access -----------------------------------------------------------------
# Shared password for the business surface (Watchlist, Inbox). Change it.
BUSINESS_PASSWORD=noma-radar
# Operator token for /ops. Change it.
OPS_TOKEN=change-me-ops-token
# Signs session cookies and derives the at-rest encryption key for Slack webhooks. Use a long random string.
SESSION_SECRET=dev-session-secret-change-me

# ---- where the app lives (used for Slack deep links) --------------------------
PUBLIC_BASE_URL=http://localhost:3000

# ---- optional -----------------------------------------------------------------
# Dead-man switch: the worker pings this URL every minute (e.g. https://hc-ping.com/<uuid>).
HEALTHCHECK_URL=
# Operator alerts (source failing, layout changed, budget exhausted) go here.
OPS_SLACK_WEBHOOK=
# Model + spend guardrail
OPENAI_MODEL=gpt-4.1-mini
LLM_DAILY_BUDGET_USD=5

# ---- local dev only (docker-compose overrides these) ---------------------------
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5434/radar
ENVIRONMENT=development
